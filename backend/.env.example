# SkillBridge AI Backend Environment Variables

# Node Environment ('development' or 'production')
NODE_ENV=production

# Server Port (assigned by hosting platforms like Render/Railway automatically)
PORT=3000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skillbridge?retryWrites=true&w=majority

# Secret key for JWT signing (use a long, secure random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key for AI features
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Allowed Frontend URL for CORS origin and cookie credentials
FRONTEND_URL=https://your-frontend-app.vercel.app

# (Optional) Custom Chrome path for Puppeteer in Docker/Linux environments
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
